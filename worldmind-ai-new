<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#071426">
  <title>WorldMind AI</title>
  <link rel="stylesheet" href="style.css">
</head>

<body>
  <header class="header">
    <div class="logo">🌍 WorldMind AI</div>
    <p>Your Intelligent AI Assistant</p>
  </header>

  <main class="container">
    <section class="welcome">
      <h1>Welcome to WorldMind AI</h1>
      <p>Your smart assistant for everyday tasks.</p>
    </section>

    <section class="features">
      <button type="button" onclick="showFeature('AI Chat')">🤖 AI Chat</button>
      <button type="button" onclick="showFeature('Voice AI')">🎙️ Voice AI</button>
      <button type="button" onclick="showFeature('Writing Assistant')">✍️ Writing</button>
      <button type="button" onclick="showFeature('Coding Assistant')">💻 Coding</button>
      <button type="button" onclick="showFeature('Study Assistant')">📚 Study</button>
      <button type="button" onclick="showFeature('Translation')">🌐 Translation</button>
    </section>

    <section class="chat-section">
      <h2 id="featureTitle">AI Chat</h2>

      <div id="chatMessages" class="chat-messages">
        <div class="message assistant">
          Hello! Welcome to WorldMind AI. How can I help you?
        </div>
      </div>

      <form id="chatForm" class="chat-form">
        <input
          type="text"
          id="userInput"
          placeholder="Type your message..."
          autocomplete="off"
          required
        >
        <button type="submit">Send</button>
      </form>
    </section>
  </main>

  <footer>
    <p>© 2026 WorldMind AI. All rights reserved.</p>
  </footer>

  <script src="script.js"></script>

  <script>
    function showFeature(name) {
      document.getElementById("featureTitle").textContent = name;
      document.getElementById("chatMessages").innerHTML = "";

      const message = document.createElement("div");
      message.className = "message assistant";
      message.textContent = name + " selected. AI service will be connected later.";

      document.getElementById("chatMessages").appendChild(message);
    }
  </script>
</body>
</html>
